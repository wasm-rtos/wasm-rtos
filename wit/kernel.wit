// wasm-rtos ABI 1.3: what a program imports from the kernel.
//
// Lowered to core wasm imports by hand ("canonical ABI lite"): every function
// returns s32, zero or a value on success and a negative `error` otherwise;
// a string is passed as (pointer, length) in UTF-8; a list<string> as a
// pointer to (pointer, length) pairs and a count. The import module of an
// interface is "wasm-rtos:kernel/<interface>@1.<minor>.0", the minor version
// the program was built for. docs/abi.md has the rules.

package wasm-rtos:kernel@1.3.0;

interface types {
    // A handle to a kernel object; it belongs to the calling program.
    type handle = s32;
    type timeout-ms = u32;          // 0xffffffff waits forever

    // Negated in every return value.
    enum error {
        ok, fault, inval, badh, nomem, limit, notfound, timeout, aborted, busy,
        notowner, full, empty, unsupported, toolong, badprogram, isdir, notdir,
        dead, mismatch, trapped, killed,
        @since(version = 1.1.0)
        inuse,
        @since(version = 1.3.0)
        nack,
        @since(version = 1.3.0)
        bus,
    }
}

interface handle {
    use types.{handle};
    close: func(h: handle) -> s32;
}

// A name of length 0 makes a private object. A name opens the existing
// object of that type and name, or creates it; parameters must then match.
interface sync {
    use types.{handle, timeout-ms};

    mutex-create: func(name: string) -> handle;
    mutex-lock: func(mutex: handle, timeout: timeout-ms) -> s32;
    mutex-unlock: func(mutex: handle) -> s32;

    semaphore-create: func(name: string, max-count: u32, initial-count: u32) -> handle;
    semaphore-take: func(semaphore: handle, timeout: timeout-ms) -> s32;
    semaphore-give: func(semaphore: handle) -> s32;

    // 24 event bits.
    flags event-wait-flags { all, clear }
    event-create: func(name: string) -> handle;
    event-set: func(event: handle, bits: u32) -> s32;       // bits after
    event-clear: func(event: handle, bits: u32) -> s32;     // bits before
    event-get: func(event: handle) -> s32;
    event-wait: func(event: handle, bits: u32, %flags: event-wait-flags, timeout: timeout-ms) -> s32;

    // item is a pointer to item-size bytes of the program's memory.
    queue-create: func(name: string, item-size: u32, capacity: u32) -> handle;
    queue-send: func(queue: handle, item: u32, timeout: timeout-ms) -> s32;
    queue-receive: func(queue: handle, item: u32, timeout: timeout-ms) -> s32;
}

// Timers count expirations; wait for the handle, then read and reset the count.
interface timer {
    use types.{handle};
    flags timer-flags { periodic }
    create: func(period-ms: u32, %flags: timer-flags) -> handle;
    start: func(timer: handle) -> s32;
    stop: func(timer: handle) -> s32;
    set-period: func(timer: handle, period-ms: u32) -> s32;
    read: func(timer: handle) -> s32;
}

interface wait {
    use types.{handle, timeout-ms};
    // Index of the first ready handle: a queue holding an item, a semaphore
    // that can be taken, an event with a bit set, an expired timer, an ended
    // child. Mutexes cannot be waited for here.
    any: func(handles: list<handle>, timeout: timeout-ms) -> s32;
}

interface proc {
    use types.{handle, timeout-ms};
    // priority 0 inherits the caller's; stack-size 0 lets the child choose.
    spawn: func(module: list<u8>, args: list<string>, priority: u32, stack-size: u32) -> handle;
    spawn-path: func(path: string, args: list<string>, priority: u32, stack-size: u32) -> handle;
    // The child's exit code, -trapped or -killed; collects the child.
    wait: func(child: handle, timeout: timeout-ms) -> s32;
    kill: func(child: handle) -> s32;
    self: func() -> s32;
    parent: func() -> s32;
}

// Pins by the device profile's names, one owner at a time.
@since(version = 1.1.0)
interface gpio {
    use types.{handle};
    flags mode { output, pull-up, pull-down, open-drain, active-low, init-high }
    flags edges { rising, falling }
    open: func(name: string, mode: mode) -> handle;
    set: func(pin: handle, level: u32) -> s32;
    get: func(pin: handle) -> s32;
    set-mode: func(pin: handle, mode: mode) -> s32;
    // The handle is ready for wait.any once a watched edge happened.
    watch: func(pin: handle, edges: edges) -> s32;
    // Edges since the last call; resets the count.
    events: func(pin: handle) -> s32;
}

// Screens by the device profile's names ("main"), one owner at a time.
@since(version = 1.2.0)
interface display {
    use types.{handle};
    // get: width, height, shape (0 rectangle, 1 round), format (the panel's
    // own), formats (bit 1 << format for each one write accepts), dpi (0:
    // unknown), brightness (0-255, -unsupported without control). A
    // property this kernel does not know is -unsupported.
    enum property { reserved, width, height, shape, format, formats, dpi, brightness }
    // mono1: 1 bit per pixel, 1 = lit, rows of whole bytes, leftmost pixel
    // in the top bit; rgb565: u16 LE, red in the top 5 bits; xrgb8888: u32
    // LE 0x00RRGGBB.
    enum pixel-format { reserved, mono1, rgb565, xrgb8888 }
    // flags must be 0.
    open: func(name: string, %flags: u32) -> handle;
    get: func(display: handle, property: property) -> s32;
    // pixels: exactly the rectangle's bytes in format; the rectangle lies
    // inside the display. Shows no later than flush.
    write: func(display: handle, x: u32, y: u32, width: u32, height: u32, format: pixel-format, pixels: list<u8>) -> s32;
    // color is one pixel value in format.
    fill: func(display: handle, x: u32, y: u32, width: u32, height: u32, format: pixel-format, color: u32) -> s32;
    flush: func(display: handle) -> s32;
    set-brightness: func(display: handle, level: u32) -> s32;
}

// Buttons, rotary controls, touch and keyboards by the device profile's
// names ("buttons", "bezel", "touch", "keyboard"), one owner at a time. The
// handle is ready for wait.any while events are queued.
@since(version = 1.2.0)
interface input {
    use types.{handle};
    enum property { reserved, kind, width, height, steps-per-turn }
    enum kind { reserved, buttons, rotary, touch, keyboard }
    // events points to max-events records of 16 bytes, little-endian:
    //   u8 type, u8 reserved, u16 code, s32 value, u16 x, u16 y, u32 time-ms
    // type 1 key (code: Linux key code; value 0 released, 1 pressed,
    // 2 repeated, 3 long press), 2 rotate (code: Linux REL_* axis; value:
    // detents, positive clockwise), 3 touch (code: contact; value 0 up,
    // 1 down, 2 move; x, y), 4 text (value: Unicode code point), 5 dropped
    // (value: events lost before the following ones). Returns the count.
    open: func(name: string, %flags: u32) -> handle;
    get: func(device: handle, property: property) -> s32;
    read: func(device: handle, events: u32, max-events: u32) -> s32;
}

// A device at an address on an I2C bus named by the device profile
// ("i2c0"); one program per address, the bus is shared.
@since(version = 1.3.0)
interface i2c {
    use types.{handle};
    // flags must be 0; address is 7-bit.
    open: func(bus: string, address: u32, %flags: u32) -> handle;
    // ops points to count records of 12 bytes, little-endian:
    //   u32 kind (1 write, 2 read), u32 data, u32 length
    // A repeated start between a write and a read, a stop at the end;
    // adjacent ops of one kind continue without a start. No ops: only the
    // address. -nack when the address or a byte is not acknowledged.
    transaction: func(device: handle, ops: u32, count: u32) -> s32;
}

// An SPI bus named by the device profile ("spi0").
@since(version = 1.3.0)
interface spi {
    use types.{handle};
    // mode: bit 0 CPHA, bit 1 CPOL, bit 2 LSB first. With a chip select
    // pin name the kernel drives it and the bus is shared; with "" the
    // program takes the bus and drives chip select through gpio.
    // frequency-hz 0 or above the bus's maximum gets the maximum.
    open: func(bus: string, chip-select: string, mode: u32, frequency-hz: u32) -> handle;
    // ops points to count records of 16 bytes, little-endian:
    //   u32 kind (1 write, 2 read, 3 transfer, 4 delay-us), u32 write,
    //   u32 read, u32 length (microseconds for a delay)
    // Chip select is held for the whole transaction; a read sends zeros.
    transaction: func(device: handle, ops: u32, count: u32) -> s32;
}

world program {
    import handle;
    import sync;
    import timer;
    import wait;
    import proc;
    @since(version = 1.1.0)
    import gpio;
    @since(version = 1.2.0)
    import display;
    @since(version = 1.2.0)
    import input;
    @since(version = 1.3.0)
    import i2c;
    @since(version = 1.3.0)
    import spi;
}
